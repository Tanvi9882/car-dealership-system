# ─────────────────────────────────────────────────────────────
# Car Dealership System — Environment Variables Template
# ─────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your real values:
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────

# DATABASE CONFIGURATION
# Option 1: SQLite (default — works out of the box, no setup needed)
DATABASE_URL=sqlite:///./car_dealership.db

# Option 2: PostgreSQL (uncomment and set your values)
# DATABASE_URL=postgresql://<username>:<password>@localhost:5432/<database_name>

# JWT SECRET KEY (required — use a long random string)
SECRET_KEY=your-very-long-random-secret-key-here

# SEED USER PASSWORDS (used only on first run when DB is empty)
ADMIN_SEED_PASSWORD=YourAdminPassword123!
USER_SEED_PASSWORD=YourUserPassword123!
